# 复制成 .env 再填。.env 不进 git（已在 .gitignore）

# ScraperAPI（免费试用注册后在 dashboard 拿 API Key）
SCRAPERAPI_KEY=

# Telegram 提醒（用公司 Telegram 账号找 @BotFather 建 bot 拿 token）
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
HERMES_NOTIFY=1
HERMES_INTERVAL_MINUTES=3
HERMES_SCRAPE_MODE=scraperapi
CHROME_CDP_URL=http://127.0.0.1:9222
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-v4-flash

# Verification Recovery（拦路页人工恢复，默认关；需配合 HERMES_SCRAPE_MODE=cdp）
HERMES_RECOVERY=0
HERMES_RECOVERY_MAX_WAIT_MIN=20
HERMES_RECOVERY_POLL_SEC=8
HERMES_RECOVERY_MAX_ROUNDS=2
HERMES_SESSION_COOKIE_DOMAINS=shopee

# Google Sheet（之后接，用公司 Google 账号建 service account）
GOOGLE_SHEET_ID=
GOOGLE_SERVICE_ACCOUNT_JSON=
