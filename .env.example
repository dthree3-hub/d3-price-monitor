# 复制成 .env 再填。.env 不进 git（已在 .gitignore）

# ScraperAPI（免费试用注册后在 dashboard 拿 API Key）
SCRAPERAPI_KEY=

# Telegram 提醒（用公司 Telegram 账号找 @BotFather 建 bot 拿 token）
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
HERMES_NOTIFY=1
HERMES_INTERVAL_MINUTES=3
HERMES_SCRAPE_MODE=scraperapi
CHROME_CDP_URL=http://127.0.0.1:9222
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-v4-flash

# Verification Recovery（碰验证页：暂停+Telegram通知你手动解，不是破解；需 HERMES_SCRAPE_MODE=cdp）
HERMES_RECOVERY=1
HERMES_RECOVERY_MAX_WAIT_MIN=3     # 最多等你解多久(分钟)；3分钟内没解→停止本轮(不继续抓)
HERMES_RECOVERY_POLL_SEC=8
HERMES_RECOVERY_MAX_ROUNDS=2
HERMES_SESSION_COOKIE_DOMAINS=shopee

# ── 定时慢速抓取（防封模型）──────────────────────────────────
# 每天几点各跑一整圈；首个(最早)时段含自家店，其余只抓对手
HERMES_RUN_TIMES=09:30,13:00,16:30
# 每条之间随机间隔(毫秒)：节奏不规律 + 慢 = 防封关键
HERMES_ITEM_DELAY_MIN_MS=10000
HERMES_ITEM_DELAY_MAX_MS=20000
HERMES_STARTUP_SWEEP=1             # 开机/启动先自动抓一轮对手(临近定时点会跳过)
HERMES_MIN_SWEEP_GAP_MINUTES=30   # 两次抓取最小间隔，防意外连抓
HERMES_MANUAL_MIN_GAP_MINUTES=5   # 手动按钮最小间隔
HERMES_SELF_SHOP_ID=54618012      # 自家店 shop_id（用于分组：self vs 对手）
# 「不登录」抓取：用全新没登录 Shopee 的 Chrome profile → 没账号可封
# 设好后在 start-chrome-cdp 前 export： CHROME_CDP_PROFILE=C:\chrome-cdp-d3-nologin

# Google Sheet（之后接，用公司 Google 账号建 service account）
GOOGLE_SHEET_ID=
GOOGLE_SERVICE_ACCOUNT_JSON=
