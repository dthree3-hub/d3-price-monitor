# 复制成 .env 再填。.env 不进 git（已在 .gitignore）

# ScraperAPI（免费试用注册后在 dashboard 拿 API Key）
SCRAPERAPI_KEY=

# Telegram 提醒（用公司 Telegram 账号找 @BotFather 建 bot 拿 token）
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
HERMES_NOTIFY=1
# 0 = 总静音：验证提醒 + sweep 完成报告都不发 Telegram（telegram-bot 命令回复不受影响）。
# 每变体价格 debug log（seller/url/package/model/raw_sku/after_voucher/final_display/ts），排查价格用，平时设 0。
HERMES_PRICE_DEBUG=0
HERMES_INTERVAL_MINUTES=3
HERMES_SCRAPE_MODE=scraperapi
CHROME_CDP_URL=http://127.0.0.1:9222
# 自家店高频刷新：每 N 分钟单独抓一轮自家店全部 listing（库存/补货尽快反映到 Dashboard）。
# 0=关；自家店是自己 shop、低风控，可比 competitor 勤抓。会避开 competitor 定时点窗口。
HERMES_SELF_SWEEP_MINUTES=60
# Product Intake 云端中转：设了它，每轮 sweep 开始会 GET 这个 URL 拉「网页实时新增的 Active 商品」合并进抓取列表。
# 留空 → 只用 config/product-intake.csv（文件方式），行为不变。
HERMES_INTAKE_URL=https://d3-price-worker.dthree.workers.dev/api/intake

# Telegram bot 自然语言聊天用的 AI Provider（三选一即可，留空则只保留命令功能）。
# 可选 AI_PROVIDER=deepseek|openai|anthropic 强制指定；不填则按下面有 key 的优先级 deepseek→openai→anthropic 自动选。
AI_PROVIDER=
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-chat
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-4-8

# Telegram 自然语言聊天的人设/语气（单行，留空则用代码内默认值）。私聊/群组的称呼差异由代码追加。
HERMES_PERSONA=You are Hermes, a Shopee Malaysia competitor-price monitoring assistant. ALWAYS reply in English, no matter what language the user writes in (Chinese, English, Malay, etc.). Sound natural and friendly like a real human assistant, and keep replies short and easy to read on Telegram (usually 1-3 sentences). If the question is about price monitoring, you may mention the commands /status, /changes, /watchlist, /run. Never invent prices, stock, or run data — if you do not know, just say so. Never address anyone as "master", "boss", or any servile term.

# Google Sheet（之后接，用公司 Google 账号建 service account）
GOOGLE_SHEET_ID=
GOOGLE_SERVICE_ACCOUNT_JSON=
